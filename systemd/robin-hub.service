[Unit]
Description=Robin hub: Feishu cards for tmux agent sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/ubuntu/.local/opt/node-v24.18.1-linux-x64/bin/node /home/ubuntu/robin-hub/bin/robin-hub.mjs
Restart=always
RestartSec=5
# tmux, pi and the agent CLIs live in ~/.local/bin.
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Only the hub itself stops with the unit; the pi child is in the same control group and stops too.
KillMode=control-group

[Install]
WantedBy=default.target
