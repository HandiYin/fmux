#!/usr/bin/env bash
# start/stop/restart agentboard in a detached tmux session
cd "$(dirname "$0")"
case "${1:-start}" in
  stop) tmux kill-session -t agentboard 2>/dev/null; echo stopped ;;
  restart) "$0" stop; sleep 0.5; "$0" start ;;
  logs) tmux capture-pane -p -t agentboard -S -80 ;;
  *) tmux has-session -t agentboard 2>/dev/null && { echo "already running: http://127.0.0.1:8789"; exit 0; }
     tmux new-session -d -s agentboard -n server "python3 server.py 2>&1 | tee -a data/server.log"
     sleep 1; echo "agentboard: http://127.0.0.1:8789" ;;
esac
